{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Linux：编译并运行 C 示例",
      "type": "process",
      "command": "${workspaceFolder}/linux",
      "args": ["demo"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Linux：检查开发环境",
      "type": "process",
      "command": "${workspaceFolder}/linux",
      "args": ["check"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always"}
    }
  ]
}
