{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Linux：编译并运行 C 示例",
      "type": "process",
      "command": "${workspaceFolder}/linux",
      "args": [
        "demo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Linux：检查开发环境",
      "type": "process",
      "command": "${workspaceFolder}/linux",
      "args": [
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "光线项目：编译检查",
      "type": "process",
      "command": "/opt/homebrew/bin/limactl",
      "args": [
        "shell",
        "--workdir",
        "${workspaceFolder}",
        "embedded-dev",
        "bash",
        "${workspaceFolder}/scripts/build-light-monitor.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "光线项目：部署并采集20次",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-light-monitor.sh",
      "args": [
        "20"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "IMX6ULL：准备代码补全头文件",
      "type": "process",
      "command": "${workspaceFolder}/scripts/vscode-imx6ull.sh",
      "args": [
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "IMX6ULL：编译当前 C 文件",
      "type": "process",
      "command": "${workspaceFolder}/scripts/vscode-imx6ull.sh",
      "args": [
        "build",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "IMX6ULL：编译并在板子运行当前 C 文件",
      "type": "process",
      "command": "${workspaceFolder}/scripts/vscode-imx6ull.sh",
      "args": [
        "run",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "传感器：全部编译检查",
      "type": "process",
      "command": "${workspaceFolder}/scripts/sensor-demos.sh",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "传感器：选择一个实验并上板运行",
      "type": "process",
      "command": "${workspaceFolder}/scripts/sensor-demos.sh",
      "args": [
        "run",
        "${input:sensorDemo}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "传感器：所有采集通道各读5次",
      "type": "process",
      "command": "${workspaceFolder}/scripts/sensor-demos.sh",
      "args": [
        "run",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "sensorDemo",
      "type": "pickString",
      "description": "选择传感器实验（默认5次；按键/触摸为5秒观察）",
      "options": [
        "als",
        "proximity",
        "ir",
        "accel",
        "gyro",
        "imu-temp",
        "adc",
        "temperature",
        "keys",
        "touch"
      ],
      "default": "als"
    }
  ]
}
